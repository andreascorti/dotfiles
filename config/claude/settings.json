{
  "awsAuthRefresh": "aws sso login --profile claude-sso",
  "env": {
    "AWS_PROFILE": "claude",
    "AWS_REGION": "eu-central-1",
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "eu.anthropic.claude-sonnet-4-6",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000",
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "true",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "allow": [
      "Read(./**)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(git:*)",
      "Bash(php artisan:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(make:*)",
      "Bash(brew:*)",
      "Bash(sed:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(whoami:*)",
      "Bash(date:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(diff:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(open:*)",
      "WebSearch",
      "WebFetch",
      "Bash(stackit:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(code:*)",
      "Bash(lsof:*)",
      "Bash(timeout:*)",
      "Bash(xargs:*)",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_close",
      "mcp__playwright__browser_take_screenshot",
      "mcp__figma-remote-mcp__get_metadata",
      "mcp__figma-remote-mcp__get_screenshot",
      "mcp__figma-remote-mcp__get_design_context",
      "mcp__code-to-figma__figma_export_image",
      "mcp__code-to-figma__figma_get_state",
      "mcp__code-to-figma__figma_edit_text",
      "mcp__code-to-figma__figma_set_properties",
      "mcp__angular-cli__list_projects",
      "mcp__obsidian"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git reset --hard*)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.ssh/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/Library/Keychains/**)"
    ],
    "defaultMode": "acceptEdits"
  },
  "skillOverrides": {
    "stackit": "off",
    "stack-plan": "off",
    "stack-sync": "off",
    "stack-review": "off",
    "stack-restack": "off",
    "stack-submit": "off",
    "stack-create": "off",
    "stack-verify": "off",
    "stack-status": "off",
    "stack-describe": "off",
    "stack-fold": "off",
    "stack-fix": "off",
    "stack-absorb": "off",
    "stack-extract": "off",
    "stack-split": "off",
    "ds-generate-variants": "user-invocable-only",
    "ds-compose-design": "user-invocable-only",
    "ds-compose-code": "user-invocable-only",
    "ds-compose": "user-invocable-only",
    "ds-rebuild-system": "user-invocable-only",
    "ds-figma-to-code": "user-invocable-only",
    "figma-generate-design": "user-invocable-only",
    "figma-generate-library": "user-invocable-only",
    "figma-implement-design": "user-invocable-only",
    "figma-create-design-system-rules": "user-invocable-only",
    "figma-code-connect-components": "user-invocable-only",
    "figma:figma-generate-design": "user-invocable-only",
    "figma:figma-generate-library": "user-invocable-only",
    "figma:figma-implement-design": "user-invocable-only",
    "figma:figma-create-design-system-rules": "user-invocable-only",
    "figma:figma-code-connect": "user-invocable-only",
    "figma:figma-use-figjam": "user-invocable-only",
    "frontend-design": "user-invocable-only",
    "frontend-design:frontend-design": "user-invocable-only",
    "theme-factory": "user-invocable-only",
    "canvas-design": "user-invocable-only",
    "web-artifacts-builder": "user-invocable-only",
    "algorithmic-art": "user-invocable-only",
    "excalidraw-skill": "user-invocable-only",
    "amadeus-slides": "user-invocable-only",
    "pdf": "user-invocable-only",
    "xlsx": "user-invocable-only",
    "docx": "user-invocable-only",
    "pptx": "user-invocable-only",
    "doc-coauthoring": "user-invocable-only",
    "internal-comms": "user-invocable-only",
    "brand-guidelines": "user-invocable-only",
    "save-note": "user-invocable-only",
    "claude-api": "user-invocable-only",
    "mcp-builder": "user-invocable-only",
    "webapp-testing": "user-invocable-only",
    "slack-gif-creator": "user-invocable-only",
    "superpowers:using-git-worktrees": "user-invocable-only",
    "superpowers:test-driven-development": "user-invocable-only",
    "superpowers:writing-skills": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "loop": "user-invocable-only",
    "init": "user-invocable-only",
    "security-review": "user-invocable-only",
    "skill-creator": "user-invocable-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ffplay -nodisp -autoexit -volume 60 -t 8 -af \"afade=t=out:st=7:d=1\" -loglevel quiet ~/.claude/sounds/wow/orgrimmar_intro-moment.mp3 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=(~/.claude/sounds/wow/PeonYes3.ogg ~/.claude/sounds/wow/PeonPissed1.ogg ~/.claude/sounds/wow/murloc.ogg); ffplay -nodisp -autoexit -volume 60 -loglevel quiet \"${f[RANDOM % ${#f[@]}]}\"' 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ffplay -nodisp -autoexit -volume 60 -loglevel quiet ~/.claude/sounds/wow/levelup2.ogg 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ffplay -nodisp -autoexit -volume 60 -loglevel quiet ~/.claude/sounds/wow/iQuestComplete.ogg 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pkill -f 'ffplay.*\\.claude/sounds/wow' 2>/dev/null; ffplay -nodisp -autoexit -volume 60 -loglevel quiet ~/.claude/sounds/wow/AstralRecall.ogg 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '(T=(\"Work, work!\" \"Zug zug\" \"Ready to work\" \"Dabu\" \"Your orders?\" \"Swobu\" \"Lok tar ogar\" \"At your command\"); S=(\"Warchief?\" \"Something need doing?\" \"More work?\" \"Me not ready\" \"Me hungry\" \"Me tired\" \"Time is money, friend\" \"Stop poking me\"); M=(\"Awaiting your input\" \"Why you poking me?\" \"Need more gold\" \"Need more lumber\" \"Jobs a-plenty\" \"What you want?\" \"Me busy\" \"No time for play\"); terminal-notifier -title \"${T[RANDOM % ${#T[@]}]}\" -subtitle \"${S[RANDOM % ${#S[@]}]}\" -message \"${M[RANDOM % ${#M[@]}]}\" -contentImage \"$HOME/.claude/icons/wow/classicon_mage.jpg\" </dev/null >/dev/null 2>&1 &)' 2>/dev/null || true",
            "async": true
          },
          {
            "type": "command",
            "command": "bash -c 'f=(~/.claude/sounds/wow/BLACK_Illidan_04.ogg ~/.claude/sounds/wow/IC_Lich_King_FMC01.ogg); ffplay -nodisp -autoexit -volume 60 -loglevel quiet \"${f[RANDOM % ${#f[@]}]}\"' 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node /Users/ascorti/.claude/statusline.mjs"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Zug zug",
      "Work work",
      "Dabu",
      "Swobu",
      "Ready to work",
      "Something need doing",
      "Jobs done",
      "Work complete",
      "More work",
      "Me busy",
      "Me not ready",
      "Me not that kind of orc",
      "Why you poking me",
      "No time for play",
      "Need more gold",
      "Need more lumber",
      "Me hungry",
      "Me tired",
      "Stop poking me",
      "Lok'tar ogar",
      "For the Horde",
      "For the Alliance",
      "Time is money, friend",
      "Leeeeeroy Jenkins",
      "Much to do",
      "At your command",
      "Mrglglglgl",
      "Aaaaaughibbrgubugbugrguburgle",
      "Rwlrwlrwlrwl",
      "Blblblblbl",
      "Mmmmgrrlrlrl",
      "Nk nk nk",
      "Wrwrlrlrl",
      "Kek",
      "You are not prepared",
      "Frostmourne hungers",
      "The Lich King watches",
      "Arthas, my son",
      "Now I am the master",
      "No king rules forever",
      "All that you know has come to an end",
      "Rise, my champion",
      "Suffering well beyond death awaits",
      "Death is only the beginning",
      "In death, we serve",
      "The living shall serve",
      "Kneel before the Lich King",
      "Face your fate, mortal",
      "None shall survive",
      "Taste icy death",
      "Icecrown beckons",
      "Flying over Northrend",
      "Mining saronite",
      "Raiding Ulduar",
      "Looting Naxxramas",
      "Channeling necrotic energy",
      "Raising ghouls",
      "Runeforging blades",
      "Summoning the Frostwyrm",
      "Culling Stratholme",
      "Questing in Howling Fjord",
      "Storming Wrathgate",
      "Grinding Sons of Hodir rep",
      "The scourge advance",
      "Ner'zhul whispers"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "autoMemoryEnabled": true,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "model": "sonnet"
}
